# syntax=docker/dockerfile:1
#
# Lean landing & documentation container (no ffmpeg, no sqlite, read-only rootfs).

FROM rust:1.99.1-bookworm AS base
WORKDIR /app

FROM base AS tool-chef
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo install cargo-chef --version 0.1.77 --locked

FROM tool-chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM tool-chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo chef cook --profile website --locked -p rupicola-site --recipe-path recipe.json
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo build --profile website --locked -p rupicola-site

FROM debian:bookworm-20261104-slim AS runtime
RUN useradd --system --no-create-home --uid 10001 rupicola

WORKDIR /app
COPY --from=builder /app/target/website/rupicola-site ./rupicola-site

USER 10001:10001
ENV HOST=0.0.0.0 \
    PORT=4732 \
    RUPICOLA_PANEL_URL=https://rupicola.lucasbrt.dev/dashboard

EXPOSE 4732
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["./rupicola-site", "--healthcheck"]
CMD ["./rupicola-site"]
