#!/usr/bin/env bash
set -euo pipefail

MSG_FILE="${1:?missing commit message file}"
FIRST_LINE="$(head -n1 "$MSG_FILE" | tr -d '\r')"

# Allow merge / revert commits generated by git
if [[ "$FIRST_LINE" =~ ^(Merge|Revert\ \") ]]; then
  exit 0
fi

PATTERN='^(feat|fix|chore|docs|refactor|test|ci|build|perf|style|revert)(\([a-z0-9._-]+\))?(!)?: .+'
if [[ ! "$FIRST_LINE" =~ $PATTERN ]]; then
  echo "Erro: commit fora do padrão Conventional Commits." >&2
  echo "Recebido: $FIRST_LINE" >&2
  echo "Esperado: <tipo>(<escopo opcional>): <descrição>" >&2
  echo "Tipos: feat, fix, chore, docs, refactor, test, ci, build, perf, style, revert" >&2
  exit 1
fi
